[1.799826, "o", "\r\n$ database\r\n"]
[2.020739, "o", "\r\r\n***База данных***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n\r\r\n***Операции с данными***\r\r\n<command> insert into <таблица> values (<значение1>, ...) - создать запись\r\r\n<command> select from <таблица> - прочитать все записи\r\r\n<command> select from <таблица> where <столбец> = <значение> - отбор записей\r\r\n<command> update <таблица> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\r\n<command> delete from <таблица> where <столбец> = <значение> - удалить записи\r\r\n"]
[2.020776, "o", "<command> info <таблица> - информация о таблице\r\r\n<command> exit - выйти из программы\r\r\n<command> help - справочная информация\r\r\nТипы: int, str, bool. Строки вводите в кавычках, bool — true/false.\r\r\n\r\r\n>>>Введите команду: "]
[2.82274, "o", "create_table users name:str age:int is_active:bool\r\r\n"]
[2.824445, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\r\n>>>Введите команду: "]
[3.628051, "o", "insert into users values (\"Sergei\", 28, true)\r\r\n"]
[3.629429, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\r\n>>>Введите команду: "]
[4.434601, "o", "insert into users values (\"Anna, Maria\", 25, false)\r\r\n"]
[4.436063, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\r\n>>>Введите команду: "]
[5.239539, "o", "select from users\r\r\n"]
[5.27217, "o", "+----+-------------+-----+-----------+\r\r\n| ID |     name    | age | is_active |\r\r\n+----+-------------+-----+-----------+\r\r\n| 1  |    Sergei   |  28 |    True   |\r\r\n| 2  | Anna, Maria |  25 |   False   |\r\r\n+----+-------------+-----+-----------+\r\r\n>>>Введите команду: "]
[6.074814, "o", "select from users where age = 28\r\r\n"]
[6.075504, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  28 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n>>>Введите команду: "]
[6.877703, "o", "update users set age = 29 where name = \"Sergei\"\r\r\n"]
[6.880157, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\r\n>>>Введите команду: "]
[7.68038, "o", "select from users where ID = 1\r\r\n"]
[7.681072, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  29 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n>>>Введите команду: "]
[8.481471, "o", "info users\r\r\n"]
[8.481813, "o", "Таблица: users\r\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\r\nКоличество записей: 2\r\r\n"]
[8.481881, "o", ">>>Введите команду: "]
[9.286892, "o", "exit\r\r\n"]
[10.101237, "o", "\r\n$ database\r\n"]
[10.16106, "o", "\r\r\n***База данных***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n\r\r\n***Операции с данными***\r\r\n<command> insert into <таблица> values (<значение1>, ...) - создать запись\r\r\n<command> select from <таблица> - прочитать все записи\r\r\n<command> select from <таблица> where <столбец> = <значение> - отбор записей\r\r\n<command> update <таблица> set <столбец> = <значение> where <столбец> = <значение> - обновить записи\r\r\n"]
[10.161162, "o", "<command> delete from <таблица> where <столбец> = <значение> - удалить записи\r\r\n<command> info <таблица> - информация о таблице\r\r\n<command> exit - выйти из программы\r\r\n<command> help - справочная информация\r\r\nТипы: int, str, bool. Строки вводите в кавычках, bool — true/false.\r\r\n\r\r\n>>>Введите команду: "]
[10.966516, "o", "select from users where ID = 1\r\r\n"]
[10.989893, "o", "+----+--------+-----+-----------+\r\r\n| ID |  name  | age | is_active |\r\r\n+----+--------+-----+-----------+\r\r\n| 1  | Sergei |  29 |    True   |\r\r\n+----+--------+-----+-----------+\r\r\n>>>Введите команду: "]
[11.793624, "o", "delete from users where ID = 1\r\r\n"]
[11.795191, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\r\n>>>Введите команду: "]
[12.597378, "o", "select from users\r\r\n"]
[12.598052, "o", "+----+-------------+-----+-----------+\r\r\n| ID |     name    | age | is_active |\r\r\n+----+-------------+-----+-----------+\r\r\n| 2  | Anna, Maria |  25 |   False   |\r\r\n+----+-------------+-----+-----------+\r\r\n"]
[12.598072, "o", ">>>Введите команду: "]
[13.399617, "o", "delete from users where ID = 2\r\r\n"]
[13.400705, "o", "Запись с ID=2 успешно удалена из таблицы \"users\".\r\r\n>>>Введите команду: "]
[14.205876, "o", "info users\r\r\n"]
[14.206248, "o", "Таблица: users\r\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\r\nКоличество записей: 0\r\r\n"]
[14.206321, "o", ">>>Введите команду: "]
[15.010238, "o", "exit\r\r\n"]
