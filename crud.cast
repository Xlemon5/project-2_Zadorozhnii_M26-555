[0.991758, "o", "\r\u001b[2K░░░░░░░░░░░░░░░░░░░░ [0/1] project-2-zadorozhnii-m26-555==0.1.0 (from file:///Users/ilya/Desktop/miphi/project-2_Zadoroz"]
