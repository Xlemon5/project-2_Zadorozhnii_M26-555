[1.244464, "o", "- project-2-zadorozhnii-m26-555==0.1.0 (from file:///Users/ilya/Desktop/miphi/project-2_Zadorozhnii_M26-555)\r\n + project-2-zadorozhnii-m26-555==0.1.0"]
[1.24448, "o", " (from file:///Users/ilya/Desktop/miphi/project-2_Zadorozhnii_M26-555/dist/project_2_zadorozhnii_m26_555-0.1.0-py3-none-any.whl)\r\n"]
[2.052528, "o", "\r\n$ database\r\n"]
[2.467592, "o", "\r\n***База данных***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - уд"]
[2.46771, "o", "алить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\nТипы: int, str, bool. Строки вводите в кавычках, bool — true/false.\r\n\r\nУдаление таблиц и записей требует подтверждения: y.\r\n\r\n>>>Введите команду: "]
[3.270723, "o", "create_table users name:str age:int is_active:bool\r\n"]
[3.27356, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n>>>Введите команду: "]
[4.074647, "o", "list_tables\r\n"]
[4.07505, "o", "- users\r\n"]
[4.075099, "o", ">>>Введите команду: "]
[4.876173, "o", "create_table users name:str\r\n"]
[4.876912, "o", "Ошибка: Таблица \"users\" уже существует.\r\n>>>Введите команду: "]
[5.678579, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[5.680207, "o", "Функция insert выполнилась за 0.000 секунд.\r\n"]
[5.682039, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n>>>Введите команду: "]
[6.487483, "o", "select from users\r\n"]
[6.488445, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[6.519257, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[7.323886, "o", "select from users where ID=1\r\n"]
[7.324291, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[7.324523, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[8.129635, "o", "select from users where ID=1\r\n"]
[8.130182, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[8.934586, "o", "insert into users values (\"Invalid\", \"28\", true)\r\n"]
[8.934929, "o", "Функция insert выполнилась за 0.000 секунд.\r\nНекорректное значение: 28. Попробуйте снова.\r\n>>>Введите команду: "]
[9.740051, "o", "select from missing\r\n"]
[9.74028, "o", "Ошибка: Таблица \"missing\" не существует.\r\n>>>Введите команду: "]
[10.545411, "o", "update users set age=29 where ID=1\r\n"]
[10.546706, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n>>>Введите команду: "]
[11.351958, "o", "select from users where ID=1\r\n"]
[11.352716, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[11.353041, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[11.353129, "o", ">>>Введите команду: "]
[12.158357, "o", "delete from users where ID=1\r\n"]
[12.159066, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[12.959555, "o", "n\r\nОперация отменена.\r\n"]
[12.959706, "o", ">>>Введите команду: "]
[13.761378, "o", "select from users where ID=1\r\n"]
[13.761987, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[14.56668, "o", "delete from users where ID=1\r\n"]
[14.567149, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[15.372304, "o", "y\r\n"]
[15.373978, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n>>>Введите команду: "]
[16.17911, "o", "select from users where ID=1\r\n"]
[16.179539, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[16.179692, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n+----+------+-----+-----------+\r\n>>>Введите команду: "]
[16.98497, "o", "drop_table users\r\n"]
[16.986141, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[17.789807, "o", "n\r\nОперация отменена.\r\n"]
[17.789911, "o", ">>>Введите команду: "]
[18.594955, "o", "info users\r\n"]
[18.595337, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n>>>Введите команду: "]
[19.398768, "o", "drop_table users\r\n"]
[19.399054, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[20.204188, "o", "y\r\n"]
[20.205295, "o", "Таблица \"users\" успешно удалена.\r\n>>>Введите команду: "]
[21.010441, "o", "list_tables\r\n"]
[21.010735, "o", "Таблиц пока нет.\r\n>>>Введите команду: "]
[21.815836, "o", "exit\r\n"]
